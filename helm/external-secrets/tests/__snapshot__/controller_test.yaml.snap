should match snapshot of default values:
  1: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: external-secrets
        app.kubernetes.io/version: v2.11.0
        application.giantswarm.io/team: honeybadger
        helm.sh/chart: external-secrets-0.0.0
      name: external-secrets
      namespace: NAMESPACE
    spec:
      replicas: 1
      revisionHistoryLimit: 10
      selector:
        matchLabels:
          app.kubernetes.io/instance: RELEASE-NAME
          app.kubernetes.io/name: external-secrets
      template:
        metadata:
          labels:
            app.kubernetes.io/instance: RELEASE-NAME
            app.kubernetes.io/managed-by: Helm
            app.kubernetes.io/name: external-secrets
            app.kubernetes.io/version: v2.11.0
            application.giantswarm.io/team: honeybadger
            helm.sh/chart: external-secrets-0.0.0
        spec:
          automountServiceAccountToken: true
          containers:
            - args:
                - --concurrent=1
                - --metrics-addr=:8080
                - --loglevel=info
                - --zap-time-encoding=epoch
              image: gsoci.azurecr.io/giantswarm/external-secrets:v2.11.0
              imagePullPolicy: IfNotPresent
              name: external-secrets
              ports:
                - containerPort: 8080
                  name: metrics
                  protocol: TCP
              resources:
                limits:
                  cpu: 100m
                  memory: 512Mi
                requests:
                  cpu: 100m
                  memory: 256Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: true
                runAsNonRoot: true
                runAsUser: 1000
                seccompProfile:
                  type: RuntimeDefault
          dnsPolicy: ClusterFirst
          hostNetwork: false
          serviceAccountName: external-secrets
